# Variables read by docker-compose.yml. Copy to ./.env (git-ignored) and fill in:
#   cp .env.docker.example .env
# Never commit real values. Generate secrets with e.g. `openssl rand -hex 32`.

# ---- Image tagging (rollback: set an older tag and `docker compose up -d`) ----
VENDORA_REGISTRY=vendora
VENDORA_TAG=local

# ---- Server runtime ----
# production = JWT secrets must be >= 32 chars, Swagger hidden unless SWAGGER_ENABLED=true
NODE_ENV=production
# Default targets the bundled mongo service (single-node replica set rs0).
# MONGO_URI=mongodb://mongo:27017/vendora?replicaSet=rs0

# REQUIRED. Two different random values, each at least 32 characters.
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Platform super admin console (landing /admin). Login is disabled while empty.
PLATFORM_ADMIN_USERNAME=
PLATFORM_ADMIN_PASSWORD=

# Browser origins allowed to call the API (landing + POS store finder), comma-separated.
# Every store subdomain from TENANT_APP_URL is allowed automatically.
CORS_ORIGINS=http://localhost:4000,http://localhost:4001
# Each store's own address; {shopId} becomes the Shop ID (production: https://{shopId}.vendora.com).
# Used in welcome / password-reset emails and to allow store origins in CORS.
TENANT_APP_URL=http://{shopId}.localhost:4001
SWAGGER_ENABLED=false

# SMTP. With SMTP_USER/SMTP_PASS empty, mails (OTP, credentials) are only logged.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Vendora Cloud <accounts@example.com>"

# ---- Frontend build args (baked into the JS bundles; public, not secrets) ----
PUBLIC_API_URL=http://localhost:5000/api/v1
PUBLIC_LANDING_URL=http://localhost:4000
# POS address without a store ("find your store" sign-in page), e.g. https://app.vendora.com
PUBLIC_POS_URL=http://localhost:4001
PUBLIC_TENANT_APP_URL=http://{shopId}.localhost:4001
PUBLIC_SUPPORT_EMAIL=support@vendora.com
