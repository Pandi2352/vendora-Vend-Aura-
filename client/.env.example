# Base URL of the Vendora API (NestJS server)
VITE_API_URL=http://localhost:5000/api/v1
# Each store's own address; {shopId} becomes the Shop ID. Production: https://{shopId}.vendora.com
VITE_TENANT_APP_URL=http://{shopId}.localhost:4001
# POS address without a store: the "find your store" sign-in page. Production e.g. https://app.vendora.com
VITE_APP_URL=http://localhost:4001
# Public landing / onboarding site
VITE_LANDING_URL=http://localhost:4000
# Address the in-app Support button emails
VITE_SUPPORT_EMAIL=support@vendora.com
