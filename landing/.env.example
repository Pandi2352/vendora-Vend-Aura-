# Base URL of the Vendora NestJS API (including the /api/v1 prefix)
VITE_API_URL=http://localhost:5000/api/v1

# POS address without a store ("find your store" sign-in page)
VITE_POS_URL=http://localhost:4001
# Each store's own address; {shopId} becomes the Shop ID. Production: https://{shopId}.vendora.com
VITE_TENANT_APP_URL=http://{shopId}.localhost:4001
